# Add this block to your existing Caddyfile (next to the heritage-exclusive.com block).
# The upstream hostnames (`InfluConnect-frontend-1`, `InfluConnect-backend-1`) are the
# default Docker container names created by `docker compose -p InfluConnect …`.
# Adjust if you use a different project/container name.

InfluConnect.fr, www.InfluConnect.fr {
    encode zstd gzip

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src https://www.youtube.com https://www.tiktok.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
        -Server
    }

    # Block sensitive paths
    @sensitive path /.env /.git*
    respond @sensitive 403

    # Django API and uploaded / collected files go to the Django container.
    # /admin is the React administration interface and stays on the frontend.
    @django {
        path /api/* /static/* /media/*
    }
    handle @django {
        request_body {
            max_size 110MB
        }
        reverse_proxy InfluConnect-backend-1:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
            header_up Host {host}
        }
    }

    # Everything else → the React SPA (served by nginx inside the frontend container)
    handle {
        reverse_proxy InfluConnect-frontend-1:8080
    }

    log {
        output file /var/log/caddy/InfluConnect.log
        format json
    }
}
