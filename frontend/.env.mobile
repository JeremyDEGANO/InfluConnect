# Build mobile (Capacitor) : vite build --mode mobile
# L'app mobile ne peut pas utiliser de chemin relatif ni localhost.
#
# Émulateur Android → backend local de la machine hôte :
VITE_API_BASE_URL=http://10.0.2.2:8000
#
# Simulateur iOS (sur Mac, backend local) : http://localhost:8000 fonctionne.
# Production : remplacer par l'URL publique du backend, ex :
# VITE_API_BASE_URL=https://api.influconnect.com
