<?xml version="1.0" encoding="utf-8"?>
<!-- Autorise le HTTP en clair uniquement vers 10.0.2.2 (backend local vu depuis
     l'émulateur Android). Tout le reste exige HTTPS, y compris en production. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
